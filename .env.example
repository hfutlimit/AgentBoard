# AgentBoard 配置
AGENTBOARD_DB_URL=sqlite:///./agentboard.db
# MariaDB 示例：mysql+pymysql://user:password@host:3306/agentboard

# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
AGENTBOARD_SECRET=replace-with-at-least-32-random-bytes

# 默认 2 天；前端会在 Token 过期后清除登录态并重新显示登录页。
AGENTBOARD_TOKEN_TTL_SECONDS=172800
AGENTBOARD_REQUIRE_AUTH=1
AGENTBOARD_ALLOW_REGISTRATION=0
AGENTBOARD_ENV=production
AGENTBOARD_CORS_ORIGINS=https://agentboard.example.com
AGENTBOARD_WEB_API_URL=https://api.agentboard.example.com

# Generate independent strong values before the first MariaDB startup.
MARIADB_PASSWORD=replace-with-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-strong-root-password
