# AgentBoard 本地开发配置模板（B-A5 / Story 291 / Epic 145）
#
# 用法：cp .env.example .env  →  替换 AGENTBOARD_SECRET 为强随机值即可本地运行。
# 生产环境请改用：cp .env.production .env  →  详见 README「生产环境部署前必读」。
#
# 本文件保持 dev 友好的默认值（REQUIRE_AUTH=1 是 .env.example 的推荐值，
# 但代码默认值是 0，本地不设此变量也能跑——dev 模式下 validate_runtime_security()
# 仅记录 WARNING 日志，不阻断启动）。

AGENTBOARD_DB_URL=sqlite:///./agentboard.db
# MariaDB 示例：mysql+pymysql://user:password@host:3306/agentboard

# 本地开发环境标注（dev 模式：validate_runtime_security() 仅 WARNING，不 fail-fast）
AGENTBOARD_ENV=development

# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
AGENTBOARD_SECRET=replace-with-at-least-32-random-bytes

# 默认 2 天；前端会在 Token 过期后清除登录态并重新显示登录页。
AGENTBOARD_TOKEN_TTL_SECONDS=172800
AGENTBOARD_REQUIRE_AUTH=1
AGENTBOARD_ALLOW_REGISTRATION=0
AGENTBOARD_ENV=production
AGENTBOARD_CORS_ORIGINS=https://agentboard.example.com
AGENTBOARD_WEB_API_URL=https://api.agentboard.example.com

# Generate independent strong values before the first MariaDB startup.
MARIADB_PASSWORD=replace-with-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-strong-root-password

# Dual-stack BFF: host port that maps to the .NET 10 WebAPI container's 8080.
# FastAPI api 占用宿主 18000，故 .NET 用 18099 避免宿主端口冲突（二者可并行
# 运行）。如需自定义，改此值即可；grayscale cutover (Stage 2) 经 nginx 将
# /api/* 切到 api-dotnet，宿主端口届时不再相关。
AGENTBOARD_DOTNET_PORT=18099
# AGENTBOARD_FASTAPI__INTERNALURL=http://api:8000   # optional override; default is http://api:8000
