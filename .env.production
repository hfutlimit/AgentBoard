# =============================================================================
# AgentBoard 生产环境配置模板（B-A5 / Story 291 / Epic 145）
# =============================================================================
# 用法：
#   cp .env.production .env
#   # 然后逐一替换所有 replace-with-* 占位符为强随机值
#
# 强制项（缺失或保留占位符时，validate_runtime_security() 会在启动时 fail-fast）：
#   - AGENTBOARD_ENV=production
#   - AGENTBOARD_SECRET  >= 32 字节（生成：python -c "import secrets; print(secrets.token_hex(32))"）
#   - AGENTBOARD_REQUIRE_AUTH=1
#   - AGENTBOARD_CORS_ORIGINS  必须是具体域名列表，禁止 *
#
# 非阻塞警告项（启动会 WARNING 但不阻断，仅维护窗口临时开启）：
#   - AGENTBOARD_ALLOW_REGISTRATION=1  ← 注册完首个 Agent 账号后立即改回 0
#
# 详见 README.md「生产环境部署前必读」章节。
# =============================================================================

# ---- 运行环境（必须 production）----
AGENTBOARD_ENV=production

# ---- HMAC 签名密钥（必须 >= 32 字节）----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# API / MCP / .NET BFF 三栈必须使用同一个 AGENTBOARD_SECRET
# （Token 跨服务校验 + 双栈切流时同一把钥匙验签）。docker-compose.yml
# 直接把这个变量同时绑定到 FastAPI 的 AGENTBOARD_SECRET 和 .NET BFF
# 的 AgentBoard__Jwt__Secret,避免漂移。
AGENTBOARD_SECRET=replace-with-at-least-32-random-bytes

# ---- 鉴权（生产必须开启）----
AGENTBOARD_REQUIRE_AUTH=1
# 注册完首个 Agent 账号后立即改回 0；需要新增账号时临时开 1，建完即恢复
AGENTBOARD_ALLOW_REGISTRATION=0

# ---- Token 有效期（默认 2 天；前端会在过期后清除登录态）----
AGENTBOARD_TOKEN_TTL_SECONDS=172800

# ---- CORS（必须具体域名，禁止 *）----
# 逗号分隔多个源；协议+域名+端口必须与前端实际访问地址完全一致。
# docker-compose.yml 把这个值映射到 FastAPI 的 AGENTBOARD_CORS_ORIGINS
# 和 .NET BFF 的 AgentBoard__CorsOrigins__0（数组第 0 个元素）。
# 多源时新增 AGENTBOARD_CORS_ORIGINS_1 / 2 ... 同时改 compose。
AGENTBOARD_CORS_ORIGINS_0=https://agentboard.example.com
AGENTBOARD_CORS_ORIGINS=https://agentboard.example.com
AGENTBOARD_WEB_API_URL=https://api.agentboard.example.com

# ---- MCP 鉴权（生产强烈建议开启）----
# MCP_REQUIRE_AUTH=1 时，调用 MCP 工具需携带具备 api:read 权限的 Bearer/API Key
# 若 MCP 与 API 分属不同服务，两端 AGENTBOARD_SECRET 必须一致
AGENTBOARD_MCP_REQUIRE_AUTH=1

# ---- 数据库（生产用 MariaDB/MySQL，不要用 SQLite）----
# MariaDB 示例：mysql+pymysql://agentboard:password@127.0.0.1:3306/agentboard
AGENTBOARD_DB_URL=mysql+pymysql://agentboard:replace-with-strong-database-password@127.0.0.1:3306/agentboard

# MariaDB 初始化（docker compose 首次启动时读取，生成独立强随机值）
MARIADB_PASSWORD=replace-with-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-strong-root-password

# ---- 可选：Worker / Agent CLI 集成 ----
# Worker 调用 Agent CLI 的命令模板（如 Codex / MiniMax）
# AGENTBOARD_WORKER_AGENT_CMD="\"<python>\" \"<invoker>\""
