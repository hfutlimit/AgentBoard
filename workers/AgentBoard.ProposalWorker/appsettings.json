    "Prefetch": 1
  },
  "Agents": {
    "WorkBuddy": {
      "Command": "workbuddy",
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "MiniMax": {
      "Command": "minimax",
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "MINIMAX_API_KEY"
    },
    "Codex": {
      "Command": "codex",
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "OPENAI_API_KEY"
    }
  },
  "ProcessExecutor": {
    "MaxOutputBytes": 102400,
    "SecretRedactionEnabled": 1,
