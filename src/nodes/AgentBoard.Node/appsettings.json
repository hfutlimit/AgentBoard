{
  "_comment_": [
    "P7b (2026-09-03): \"Node\" is the canonical options section. \"Worker\" is",
    "kept for one release as a fallback - Program.cs reads \"Node\" first and",
    "only falls back to \"Worker\" when no \"Node\" section exists, so an",
    "already-deployed appsettings.Local.json keeps booting unchanged."
  ],
  "Node": {
    "Id": "",
    "HeartbeatSeconds": 15,
    "HistoryDatabasePath": "data\\proposal-worker.db",
    "MaxConcurrentExecutions": 1,
    "DispatchChannelCapacity": 100,
    "OrphanThresholdMinutes": 30,
    "MaxPendingInbox": 1000,
    "Version": "1.4.0"
  },
  "Worker": {
    "_comment_": "Deprecated alias of the Node section. Removed after the P7b grace period.",
    "Id": "",
    "HeartbeatSeconds": 15,
    "HistoryDatabasePath": "data\\proposal-worker.db",
    "MaxConcurrentExecutions": 1,
    "DispatchChannelCapacity": 100,
    "OrphanThresholdMinutes": 30,
    "MaxPendingInbox": 1000,
    "Version": "1.4.0"
  },
  "RabbitMq": {
    "Uri": "",
    "Namespace": "agentboard.proposals",
    "PublicRoutingKey": "dispatch",
    "DirectExchangeSuffix": ".direct",
    "Prefetch": 1
  },
  "Agents": {
    "WorkBuddy": {
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text" ],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "MiniMax": {
      "Command": "minimax",
      "Arguments": [ "-p" ],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "MINIMAX_API_KEY"
    },
    "Codex": {
      "Command": "codex",
      "Arguments": [ "exec", "--json", "--dangerously-bypass-approvals-and-sandbox" ],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "OPENAI_API_KEY"
    },
    "Qwen": {
      "_comment_": "千问办公 agent. Disabled by default. Point Command at the",
      "_comment_2": "python.exe and Arguments at scripts/qwen_invoker.py; set",
      "_comment_3": "QWEN_API_KEY (+ optional QWEN_MODEL=qwen3.8-flash) in the",
      "_comment_4": "worker env. Single-shot unattended invoker (no approval gate).",
      "Command": "",
      "Arguments": [],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "QWEN_API_KEY"
    },
    "Fake": {
      "Command": "",
      "WorkingDirectory": "",
      "TimeoutMinutes": 1,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "Scenario": {
      "Command": "",
      "WorkingDirectory": "",
      "TimeoutMinutes": 1,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    }
  },
  "ProcessExecutor": {
    "MaxOutputBytes": 102400,
    "SecretRedactionEnabled": 1,
    "LogDirectory": "data\\execution-logs"
  },
  "AgentBoard": {
    "HeartbeatUrl": "",
    "WebSocketUrl": ""
  },
  "Portal": {
    "Urls": "http://127.0.0.1:58240",
    "ApiKey": ""
  }
}
