{
  "_comment_": [
    "P7b (2026-09-03): \"Node\" is the canonical options section, \"Worker\" is the",
    "one-release legacy alias. Program.cs binds \"Worker\" first as the baseline",
    "and then layers \"Node\" on top, overriding only the keys that are ACTUALLY",
    "PRESENT in the Node section (and non-empty).",
    "",
    "This base file therefore ships ONLY the \"Worker\" section, on purpose. A",
    "\"Node\" section here would list every default key, and since the layering",
    "rule is \"present wins\", those shipped defaults would silently override an",
    "operator's Worker:HeartbeatSeconds / Worker:HistoryDatabasePath /",
    "Worker:MaxConcurrentExecutions from appsettings.Local.json. \"Node\" belongs",
    "in the deploy-time files (appsettings.Local.json / .Production.json) - see",
    "appsettings.Local.template.json."
  ],
  "Worker": {
    "Id": "",
    "HeartbeatSeconds": 15,
    "HistoryDatabasePath": "data\\proposal-worker.db",
    "MaxConcurrentExecutions": 1,
    "DispatchChannelCapacity": 100,
    "OrphanThresholdMinutes": 30,
    "MaxPendingInbox": 1000,
    "Version": "1.4.0"
  },
  "RabbitMq": {
    "Uri": "",
    "Namespace": "agentboard.proposals",
    "PublicRoutingKey": "dispatch",
    "DirectExchangeSuffix": ".direct",
    "Prefetch": 1
  },
  "DurableExecution": {
    "Enabled": false,
    "DatabasePath": "",
    "PolicyPreset": "developer",
    "ProjectId": "local-project",
    "WorkspaceId": "local-workspace",
    "WorkspaceBaseVersion": "working-tree",
    "Workspaces": [],
    "Prefetch": 4
  },
  "Agents": {
    "WorkBuddy": {
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text" ],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "MiniMax": {
      "Command": "minimax",
      "Arguments": [ "-p" ],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "MINIMAX_API_KEY"
    },
    "Codex": {
      "Command": "codex",
      "Arguments": [ "exec", "--json", "--dangerously-bypass-approvals-and-sandbox" ],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "OPENAI_API_KEY"
    },
    "Qwen": {
      "_comment_": "千问办公 agent. Disabled by default. Point Command at the",
      "_comment_2": "python.exe and Arguments at scripts/qwen_invoker.py; set",
      "_comment_3": "QWEN_API_KEY (+ optional QWEN_MODEL=qwen3.8-flash) in the",
      "_comment_4": "worker env. Single-shot unattended invoker (no approval gate).",
      "Command": "",
      "Arguments": [],
      "WorkingDirectory": "",
      "TimeoutMinutes": 30,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "QWEN_API_KEY"
    },
    "Fake": {
      "Command": "",
      "WorkingDirectory": "",
      "TimeoutMinutes": 1,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "Scenario": {
      "Command": "",
      "WorkingDirectory": "",
      "TimeoutMinutes": 1,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    }
  },
  "ProcessExecutor": {
    "MaxOutputBytes": 102400,
    "SecretRedactionEnabled": 1,
    "LogDirectory": "data\\execution-logs"
  },
  "AgentBoard": {
    "HeartbeatUrl": "",
    "WebSocketUrl": ""
  },
  "Portal": {
    "Urls": "http://127.0.0.1:58240",
    "ApiKey": ""
  }
