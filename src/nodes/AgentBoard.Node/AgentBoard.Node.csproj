<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="WorkerOwned/ConfigurationPortal.html" />
    <ProjectReference Include="..\..\contracts\AgentBoard.Contracts\AgentBoard.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals (BoundedByteQueue, etc.) to the unit test project
         so we can unit-test the streaming bounded buffer directly without
         making it part of the public API. -->
    <InternalsVisibleTo Include="AgentBoard.Node.Tests" />
  </ItemGroup>
</Project>
