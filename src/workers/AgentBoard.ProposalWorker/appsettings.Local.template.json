{
  "_comment_": [
    "TEMPLATE for a local .NET Worker deploy. Copy to appsettings.Local.json",
    "(git-ignored) and let scripts/local-deploy-worker.ps1 inject real tokens,",
    "or fill them by hand. NEVER commit appsettings.Local.json with live secrets",
    "- it was previously tracked and leaked real broker/agent tokens (see the",
    "rotation note in that commit's review). Replace the AMQP URI + fill tokens;",
    "the deploy script auto-fills the four token-injection markers below in",
    "WorkBuddy -> Codex -> StartupToken -> Portal.ApiKey order."
  ],
  "Worker": {
    "Id": "dotnet-local-01",
    "HeartbeatSeconds": 15,
    "HistoryDatabasePath": "data\\proposal-worker.db",
    "MaxConcurrentExecutions": 1,
    "OrphanThresholdMinutes": 30,
    "MaxPendingInbox": 1000,
    "Version": "1.4.0"
  },
  "RabbitMq": {
    "Uri": "amqp://USER:PASSWORD@HOST:5672/%2F",
    "Namespace": "agentboard.proposals",
    "PublicRoutingKey": "dispatch",
    "DirectExchangeSuffix": ".direct",
    "Prefetch": 1
  },
  "Agents": {
    "WorkBuddy": {
      "_comment": "codebuddy CLI (OAuth, default model picked by dispatch priority). CliLocator auto-discovers the binary.",
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text" ],
      "WorkingDirectory": "",
      "AgentId": "wb-main",
      "AgentBoardToken": "PLACEHOLDER_REPLACED_BY_DEPLOY_SCRIPT",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "MiniMax": { "Command": "" },
    "Codex": {
      "_comment": "codex CLI (OpenAI). CliLocator auto-discovers the binary.",
      "Command": "codex",
      "Arguments": [ "exec", "--json", "--dangerously-bypass-approvals-and-sandbox" ],
      "WorkingDirectory": "",
      "AgentId": "codex-main",
      "AgentBoardToken": "PLACEHOLDER_REPLACED_BY_DEPLOY_SCRIPT",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "OPENAI_API_KEY"
    },
    "Qwen": {
      "_comment_": "千问办公 (Qwen) — single-shot unattended invoker.",
      "_comment_2": "Model comes from QWEN_MODEL (default qwen3.8-flash);",
      "_comment_3": "QWEN_API_KEY must be in the worker env. Point Command at",
      "_comment_4": "your python.exe and Arguments at scripts/qwen_invoker.py.",
      "Command": "python",
      "Arguments": [ "scripts/qwen_invoker.py" ],
      "WorkingDirectory": "",
      "AgentId": "qwen-main",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": "QWEN_API_KEY"
    },
    "Fake": { "Command": "" },
    "Scenario": { "Command": "" },
    "M3": {
      "_comment": "minimax-M3 via codebuddy CLI (OAuth, same account as IDE).",
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text", "--model", "minimax-m3" ],
      "WorkingDirectory": "",
      "AgentId": "m3-agent",
      "AgentBoardToken": "",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "M27": {
      "_comment": "minimax-M2.7 via codebuddy CLI (OAuth).",
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text", "--model", "minimax-m2.7" ],
      "WorkingDirectory": "",
      "AgentId": "m27-agent",
      "AgentBoardToken": "",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "Hy4": {
      "_comment": "hy4-preview via codebuddy CLI (OAuth, currently free preview).",
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text", "--model", "hy4-preview" ],
      "WorkingDirectory": "",
      "AgentId": "hy4-agent",
      "AgentBoardToken": "",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "Glm53F": {
      "_comment": "GLM-5.3-flash via codebuddy CLI (OAuth).",
      "Command": "codebuddy",
      "Arguments": [ "-p", "-y", "--output-format", "text", "--model", "glm-5.3-flash" ],
      "WorkingDirectory": "",
      "AgentId": "glm53f-agent",
      "AgentBoardToken": "",
      "TimeoutMinutes": 10,
      "MaxCapturedOutputChars": 20000,
      "ApiKeyEnv": ""
    },
    "DefaultAgent": "Hy4"
  },
  "ProcessExecutor": {
    "MaxOutputBytes": 102400,
    "SecretRedactionEnabled": 1,
    "LogDirectory": "data\\execution-logs"
  },
  "AgentBoard": {
    "ServerUrl": "http://REPLACE-HOST",
    "StartupToken": "PLACEHOLDER_REPLACED_BY_DEPLOY_SCRIPT",
    "RequireRegistration": true,
    "HeartbeatUrl": "",
    "WebSocketUrl": ""
  },
  "Portal": {
    "Urls": "http://127.0.0.1:58240",
    "ApiKey": "PLACEHOLDER_REPLACED_BY_DEPLOY_SCRIPT"
  }
}
