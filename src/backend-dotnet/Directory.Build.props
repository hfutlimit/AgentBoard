<Project>

  <!-- Common properties for all projects under this directory -->
  <PropertyGroup>
    <!-- C# language version follows the .NET 10 SDK default. -->
    <LangVersion>latest</LangVersion>

    <!-- Nullable reference types and warnings-as-errors are required for new code. -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
        Excluded advisory codes (NU1902 / NU1903) are known to lag behind
        upstream fixes. The relevant packages have no newer version that
        clears the advisory at the time of writing:
          - Microsoft.OpenApi 2.0.x           (NU1903, GHSA-v5pm-xwqc-g5wc)
          - System.Security.Cryptography.Xml 9 (NU1903, multiple)
          - SQLitePCLRaw.lib.e_sqlite3 2.1.11  (NU1903, GHSA-2m69-gcr7-jv3q)
          - OpenTelemetry.Api 1.10-1.11        (NU1902, GHSA-8785-wc3w-h8q6 + GHSA-g94r-2vxg-569j)
        Re-evaluate every .NET SDK bump; remove the exclusion when the
        advisory database catches up.
    -->
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>

    <!-- Deterministic builds and SourceLink for debugging. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Encoding / culture. -->
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- NOTE on Central Package Management:
       We deliberately do NOT enable <ManagePackageVersionsCentrally> yet.
       Each csproj declares an explicit Version attribute. When the dependency
       list grows past ~10 packages we'll introduce Directory.Packages.props
       and migrate to CPM in a single sweep (see S0-2 task list). -->

</Project>
