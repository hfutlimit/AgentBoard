# Copy to tmp/agentboard-worker/.env.worker and fill the token locally.
AGENTBOARD_API_URL=http://127.0.0.1:58124
AGENTBOARD_WORKER_ID=worker-hostname
AGENTBOARD_WORKER_TOKEN=REPLACE_WITH_LOGIN_TOKEN
# Startup bridges this token to AgentBoard_Api_Key for Codex MCP auth unless
# AGENTBOARD_MCP_TOKEN is provided explicitly.
AGENTBOARD_WORKER_AGENT=codex
AGENTBOARD_WORKER_INTERVAL=10
AGENTBOARD_WORKER_AGENT_TIMEOUT=900
AGENTBOARD_WORKER_TASK_POLL=1
# Comma-separated project IDs mapped to this computer; leave unset to read
# tmp/project-mappings.json.  A worker only claims todo Tasks in these projects.
AGENTBOARD_WORKER_PROJECT_IDS=3

# Optional: use a different public MCP endpoint.
# AGENTBOARD_MCP_URL=http://127.0.0.1:8001/mcp

# The startup script writes tmp/mcp-prod.json automatically from
# AGENTBOARD_MCP_URL or AGENTBOARD_API_URL/mcp.
AGENTBOARD_WORKER_AGENT_COMMANDS={"codex":"\"codex\" exec --model \"gpt-5.6-sol\" --dangerously-bypass-approvals-and-sandbox --color never"}
AGENTBOARD_WORKER_AGENT_ROUTING={"clarify":"codex","create_ticket":"codex","process_story":"codex","review":"codex","owner_response":"codex"}
